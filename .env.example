# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Optional. YouTube Data API v3.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# APP_URL: Public URL of the app (e.g. https://cinereactoficial.up.railway.app)
# No Railway, use a URL real — NÃO use MY_APP_URL. Se vazio, o app usa RAILWAY_PUBLIC_DOMAIN.
APP_URL=""

# CORS_ORIGINS: Comma-separated allowed origins (optional; Railway domain auto-allowed)
# CORS_ORIGINS="https://cinereactoficial.up.railway.app"

# --- Auth & sessions (obrigatório em produção) ---
# SESSION_SECRET: Random string 32+ chars for signing session cookies. Never share.
SESSION_SECRET=""

# BOOTSTRAP_ADMIN_EMAIL + BOOTSTRAP_ADMIN_PASSWORD: First admin created on boot if no users exist.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# --- Supabase (backup/sync + login Discord) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
# Login Discord: Supabase → Authentication → Providers → Discord (habilitar)
# Redirect URLs em Authentication → URL Configuration:
#   https://<seu-dominio>/api/auth/oauth/callback
# Cadastro por e-mail não exige verificação de e-mail.

# --- Mercado Pago (assinaturas) ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# SUBSCRIPTION_GLOBAL_MP_LINK / SUBSCRIPTION_EXCLUSIVE_MP_LINK: Static checkout links
# SUBSCRIPTION_GLOBAL_MP_LINK=""
# SUBSCRIPTION_EXCLUSIVE_MP_LINK=""

# --- Railway / data ---
# CINE_REACT_DATA_DIR="/data"
# ENABLE_STARTUP_YOUTUBE_SYNC=1
