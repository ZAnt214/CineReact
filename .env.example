# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Optional. Used to query the real YouTube Data API v3.
# If not specified, the system will use Gemini AI to simulate intelligent react searches.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project (e.g., https://xyz.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Server-only key for Supabase sync (Settings → API → service_role).
# Required when Row Level Security is enabled. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Legacy fallback only. Prefer SUPABASE_SERVICE_ROLE_KEY on the server.
SUPABASE_ANON_KEY=""

# CINE_REACT_DATA_DIR: Persistent data directory for CineClips DB and uploads.
# Em produção (Railway) o padrão é /data, configurado automaticamente via railway.toml.
# CINE_REACT_DATA_DIR="/data"
